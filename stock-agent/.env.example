# copy to .env and fill in. get free keys at https://console.groq.com/keys
# ONE key:
GROQ_API_KEY=gsk_your_key_here
# OR several keys (comma-separated) to rotate when one hits its rate limit:
# GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three
# big model does the tool-calling / reasoning, small model does the cheap classification
AGENT_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant
