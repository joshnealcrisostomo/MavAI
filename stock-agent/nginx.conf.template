worker_processes 1;
events { worker_connections 1024; }

http {
    access_log /dev/stdout;
    error_log  /dev/stderr;

    # needed so websocket upgrades (Streamlit) get forwarded correctly
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }

    server {
        # $PORT is filled in at startup by envsubst (default 8080)
        listen ${PORT};

        # FastAPI channel under /api/
        location /api/ {
            proxy_pass http://127.0.0.1:8000/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            # turn buffering off so SSE events stream through immediately
            proxy_buffering off;
            proxy_set_header X-Accel-Buffering no;
            proxy_read_timeout 3600;
        }

        # Streamlit channel at root (with websocket support)
        location / {
            proxy_pass http://127.0.0.1:8501/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600;
        }
    }
}
